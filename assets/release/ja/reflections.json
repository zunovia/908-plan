{
  "version": 1,
  "items": [
    {"id": "IMP1", "emotion": "IMPATIENCE", "text": "「{w}」のあたりで、急がなきゃという再生が始まっているのでしょうか。", "needsWord": true},
    {"id": "IMP2", "emotion": "IMPATIENCE", "text": "間に合わない感じが、いちばん近いですか。", "needsWord": false},
    {"id": "IMP3", "emotion": "IMPATIENCE", "text": "焦りが先に動いているのですね。", "needsWord": false},
    {"id": "ANX1", "emotion": "ANXIETY", "text": "「{w}」が、どうしようという形で回っているのですね。", "needsWord": true},
    {"id": "ANX2", "emotion": "ANXIETY", "text": "落ち着かない感じが続いているのでしょうか。", "needsWord": false},
    {"id": "ANX3", "emotion": "ANXIETY", "text": "先のことが、いま再生されているのですね。", "needsWord": false},
    {"id": "ANG1", "emotion": "ANGER", "text": "「{w}」に、納得できない気持ちが向いているのですね。", "needsWord": true},
    {"id": "ANG2", "emotion": "ANGER", "text": "怒りが、まだ熱いまま残っているのでしょうか。", "needsWord": false},
    {"id": "ANG3", "emotion": "ANGER", "text": "許せない、という再生が強いですね。", "needsWord": false},
    {"id": "SAD1", "emotion": "SADNESS", "text": "「{w}」が、静かに重いのですね。", "needsWord": true},
    {"id": "SAD2", "emotion": "SADNESS", "text": "悲しみが、言葉より先に来ているのでしょうか。", "needsWord": false},
    {"id": "SAD3", "emotion": "SADNESS", "text": "失った感じが近いですか。", "needsWord": false},
    {"id": "LON1", "emotion": "LONELINESS", "text": "誰にも届いていない感じが、いちばん近いでしょうか。", "needsWord": false},
    {"id": "LON2", "emotion": "LONELINESS", "text": "ひとりで抱えている時間が長かったのですね。", "needsWord": false},
    {"id": "LON3", "emotion": "LONELINESS", "text": "「{w}」の中で、置いていかれた感じがするのですね。", "needsWord": true},
    {"id": "GLT1", "emotion": "GUILT", "text": "「{w}」のことで、自分を責める再生が回っているのですね。", "needsWord": true},
    {"id": "GLT2", "emotion": "GUILT", "text": "申し訳なさが、まだ残っているのでしょうか。", "needsWord": false},
    {"id": "GLT3", "emotion": "GUILT", "text": "悪かった、という声が強いですね。", "needsWord": false},
    {"id": "SHM1", "emotion": "SHAME", "text": "「{w}」を思い出すと、消えたくなるのですね。", "needsWord": true},
    {"id": "SHM2", "emotion": "SHAME", "text": "誰かの目が、いま再生されているのでしょうか。", "needsWord": false},
    {"id": "SHM3", "emotion": "SHAME", "text": "情けなさが近いですか。", "needsWord": false},
    {"id": "FER1", "emotion": "FEAR", "text": "「{w}」が、怖さとして来ているのですね。", "needsWord": true},
    {"id": "FER2", "emotion": "FEAR", "text": "身がすくむ感じでしょうか。", "needsWord": false},
    {"id": "FER3", "emotion": "FEAR", "text": "何かが起きそうで、構えているのですね。", "needsWord": false},
    {"id": "FAT1", "emotion": "FATIGUE", "text": "気持ちより先に、身体が疲れているのかもしれませんね。", "needsWord": false},
    {"id": "FAT2", "emotion": "FATIGUE", "text": "もう無理、という再生が回っているのですね。", "needsWord": false},
    {"id": "FAT3", "emotion": "FATIGUE", "text": "休む許可が出ていないのでしょうか。", "needsWord": false},
    {"id": "ENV1", "emotion": "ENVY", "text": "「{w}」を見て、自分に足りない感じが再生されたのですね。", "needsWord": true},
    {"id": "ENV2", "emotion": "ENVY", "text": "比べる声が強いですか。", "needsWord": false},
    {"id": "ENV3", "emotion": "ENVY", "text": "欲しいのに持てない感じでしょうか。", "needsWord": false},
    {"id": "CNF1", "emotion": "CONFUSION", "text": "頭の中で、いくつもの再生が同時に鳴っているのですね。", "needsWord": false},
    {"id": "CNF2", "emotion": "CONFUSION", "text": "どれが本当かわからない感じでしょうか。", "needsWord": false},
    {"id": "CNF3", "emotion": "CONFUSION", "text": "整理する前に、まず静かにしたいのですね。", "needsWord": false},
    {"id": "CLM1", "emotion": "CALM", "text": "いまは少し静かなのですね。その感じを覚えておきましょう。", "needsWord": false},
    {"id": "CLM2", "emotion": "CALM", "text": "再生が止んでいる時間ですね。", "needsWord": false},
    {"id": "CLM3", "emotion": "CALM", "text": "ここが、あなたの本来の場所です。", "needsWord": false},
    {"id": "GEN1", "emotion": "GENERIC", "text": "いま感じていることを、ここに置いてくれたのですね。", "needsWord": false},
    {"id": "GEN2", "emotion": "GENERIC", "text": "うまく言葉にならなくても、ここに来てくれたのですね。", "needsWord": false},
    {"id": "GEN3", "emotion": "GENERIC", "text": "何かが動いているのを、感じているのですね。", "needsWord": false},
    {"id": "GEN4", "emotion": "GENERIC", "text": "名前のつかない気持ちも、ここに置いていいですよ。", "needsWord": false},
    {"id": "GEN5", "emotion": "GENERIC", "text": "いま、何かに気づいているところなのですね。", "needsWord": false},
    {"id": "GEN6", "emotion": "GENERIC", "text": "その感じを、まだ言葉にしなくても大丈夫です。", "needsWord": false}
  ]
}
