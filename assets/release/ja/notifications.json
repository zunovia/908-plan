{
  "version": 1,
  "items": [
    {
      "id": "n001",
      "slot": "MORNING",
      "text": "今日の最初の『ありがとう』は、誰に？"
    },
    {
      "id": "n002",
      "slot": "MORNING",
      "text": "今日見るものは、記憶のフィルターを通ります。朝に、ひと言。"
    },
    {
      "id": "n003",
      "slot": "MORNING",
      "text": "今日のフィルターに、ひと言かけてから出かけましょう。"
    },
    {
      "id": "n004",
      "slot": "MORNING",
      "text": "朝の空気を感じながら、ありがとう、と1回。"
    },
    {
      "id": "n005",
      "slot": "MORNING",
      "text": "今日いちばん会いたい人は、誰ですか。"
    },
    {
      "id": "n006",
      "slot": "MORNING",
      "text": "起きたときの気持ちに、名前をつけるなら？"
    },
    {
      "id": "n007",
      "slot": "MORNING",
      "text": "今日の予定より先に、自分の中を少し整えましょう。"
    },
    {
      "id": "n008",
      "slot": "MORNING",
      "text": "今日いちばん大切にしたいことは、何ですか。"
    },
    {
      "id": "n009",
      "slot": "MORNING",
      "text": "新しい1日に、ありがとう、と1回。"
    },
    {
      "id": "n010",
      "slot": "MORNING",
      "text": "今日見るものが、少し違って見えるとしたら？"
    },
    {
      "id": "n011",
      "slot": "MORNING",
      "text": "今日の最初の一歩に、愛しています、と1回。"
    },
    {
      "id": "n012",
      "slot": "MORNING",
      "text": "今日は、どんな自分で過ごしたいですか。"
    },
    {
      "id": "n013",
      "slot": "NOON",
      "text": "いまの気持ちに、×をひとつ。"
    },
    {
      "id": "n014",
      "slot": "NOON",
      "text": "午後も、いまの気持ちから始めましょう。"
    },
    {
      "id": "n015",
      "slot": "NOON",
      "text": "いま聞いたことに、ひと言かけてから、次へ。"
    },
    {
      "id": "n016",
      "slot": "NOON",
      "text": "午前中のことに、ありがとう、と1回。"
    },
    {
      "id": "n017",
      "slot": "NOON",
      "text": "今、肩の力を少し抜いてみましょう。"
    },
    {
      "id": "n018",
      "slot": "NOON",
      "text": "午後のフィルターに、ひと言。"
    },
    {
      "id": "n019",
      "slot": "NOON",
      "text": "いまの疲れに、ありがとう、と1回。"
    },
    {
      "id": "n020",
      "slot": "NOON",
      "text": "今日のここまでに、愛しています、と1回。"
    },
    {
      "id": "n021",
      "slot": "NOON",
      "text": "午後、何を見聞きしても、フィルターにひと言。"
    },
    {
      "id": "n022",
      "slot": "NOON",
      "text": "いまの気分に、名前をつけるなら？"
    },
    {
      "id": "n023",
      "slot": "NOON",
      "text": "お昼の一息に、ありがとう、と1回。"
    },
    {
      "id": "n024",
      "slot": "NOON",
      "text": "午後も、ひと言で手放せます。"
    },
    {
      "id": "n025",
      "slot": "NIGHT",
      "text": "今日はここまでで大丈夫。ひと言だけ、手放して眠りましょう。"
    },
    {
      "id": "n026",
      "slot": "NIGHT",
      "text": "眠る前に、今日見聞きしたものへ、ありがとう、と1回。"
    },
    {
      "id": "n027",
      "slot": "NIGHT",
      "text": "今日の分は、もう手放していいですよ。"
    },
    {
      "id": "n028",
      "slot": "NIGHT",
      "text": "布団に入ったら、今日のフィルターを外に置いて。"
    },
    {
      "id": "n029",
      "slot": "NIGHT",
      "text": "今日いちばん重かった気持ちに、愛しています、と1回。"
    },
    {
      "id": "n030",
      "slot": "NIGHT",
      "text": "続きは明日の自分に任せて、おやすみなさい。"
    },
    {
      "id": "n031",
      "slot": "NIGHT",
      "text": "今日あったことに、ひと言かけて、目を閉じましょう。"
    },
    {
      "id": "n032",
      "slot": "NIGHT",
      "text": "今夜は、ただ手放して眠るだけで十分です。"
    },
    {
      "id": "n033",
      "slot": "NIGHT",
      "text": "眠る前の静けさに、ありがとう、と1回。"
    },
    {
      "id": "n034",
      "slot": "NIGHT",
      "text": "今日の出来事を、ひとつずつ置いていきましょう。"
    },
    {
      "id": "n035",
      "slot": "NIGHT",
      "text": "今夜のひと言は、誰に向けますか。"
    },
    {
      "id": "n036",
      "slot": "NIGHT",
      "text": "明かりを消す前に、今日に、ありがとう。"
    },
    {
      "id": "n037",
      "slot": "BELL",
      "text": "（小さな鐘）いま、ここ。"
    },
    {
      "id": "n038",
      "slot": "BELL",
      "text": "（鐘）いま、何のフィルターで見ている？ ありがとう、と一度。"
    },
    {
      "id": "n039",
      "slot": "BELL",
      "text": "（鐘）いまの一瞬に、ひと言。"
    },
    {
      "id": "n040",
      "slot": "BELL",
      "text": "（鐘）いま、何が再生している？"
    },
    {
      "id": "n041",
      "slot": "BELL",
      "text": "（鐘）いま聞こえている音に、ありがとう。"
    },
    {
      "id": "n042",
      "slot": "BELL",
      "text": "（鐘）いまの自分に、愛しています。"
    },
    {
      "id": "n043",
      "slot": "BELL",
      "text": "（鐘）少し、止まってみましょう。"
    },
    {
      "id": "n044",
      "slot": "BELL",
      "text": "（鐘）いま、肩の力は入っていますか。"
    },
    {
      "id": "n045",
      "slot": "BELL",
      "text": "（鐘）いまの景色に、ひと言かけて。"
    },
    {
      "id": "n046",
      "slot": "BELL",
      "text": "（鐘）いま、何を考えていましたか。"
    },
    {
      "id": "n047",
      "slot": "BELL",
      "text": "（鐘）いまのひと呼吸に、ありがとう。"
    },
    {
      "id": "n048",
      "slot": "BELL",
      "text": "（鐘）いま、ここに戻ってきましょう。"
    },
    {
      "id": "n049",
      "slot": "BELL",
      "text": "（鐘）いまの気持ちに、ひと言。"
    },
    {
      "id": "n050",
      "slot": "BELL",
      "text": "（鐘）いま、何も知らなくていい。"
    }
  ]
}
